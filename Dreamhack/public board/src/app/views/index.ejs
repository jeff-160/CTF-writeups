<%- include("partials/head", { title: title, user: user }) %>
<h1 class="page-title">Post List</h1>
<p class="page-subtitle"><%= posts.length %> posts in total</p>
<%- include("partials/note", { note: note }) %>
<ul class="post-list">
  <% if (posts.length) { %>
    <% posts.forEach((post) => { %>
      <li>
        <a href="/posts/<%= post.id %>">
          <p class="post-title"><%= post.title %></p>
          <p class="post-meta">by <%= post.author %></p>
        </a>
      </li>
    <% }) %>
  <% } else { %>
    <li>
      <a href="/">
        <p class="post-title">No posts</p>
        <p class="post-meta">Create the first post.</p>
      </a>
    </li>
  <% } %>
</ul>
<%- include("partials/foot") %>
